{
  "name": "@kritva/db",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "description": "Drizzle ORM schema, client, and SQL migrations for the Kritva Postgres database.",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:raw": "./migrations/run_all.sh",
    "db:seed": "tsx src/seed.ts",
    "db:promote-admin": "tsx src/promote-admin.ts",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@kritva/types": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@kritva/eslint-config": "workspace:*",
    "@kritva/tsconfig": "workspace:*",
    "@types/node": "^22.15.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "tsx": "^4.22.4",
    "typescript": "5.9.2"
  }
}
