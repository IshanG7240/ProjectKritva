# DATABASE
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-1-[YOUR_REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"                    # Supabase Postgres connection string (pooled via PgBouncer)
DATABASE_URL_DIRECT="postgresql://postgres.[YOUR_PROJECT_ID]:[YOUR_PASSWORD]@aws-1-[YOUR_REGION].pooler.supabase.com:5432/postgres"             # Direct connection (for migrations only)
SUPABASE_URL=""                    # Supabase project URL
SUPABASE_ANON_KEY=""               # Supabase anon key (public, used by frontend realtime)
SUPABASE_SERVICE_ROLE_KEY=""       # Supabase service role (server-side only, bypasses RLS)

# AUTH
JWT_PRIVATE_KEY=""                 # RS256 private key (PEM format, for signing)
JWT_PUBLIC_KEY=""                  # RS256 public key (PEM format, for verification)
JWT_ACCESS_TOKEN_EXPIRY="15m"      # Access token expiry (e.g. 15m)
JWT_REFRESH_TOKEN_EXPIRY="30d"     # Refresh token expiry (e.g. 30d)
ADMIN_JWT_PRIVATE_KEY=""           # Separate key pair for admin tokens
ADMIN_JWT_PUBLIC_KEY=""

# PAYMENTS (Razorpay Route)
RAZORPAY_KEY_ID=""                 # Razorpay API key ID
RAZORPAY_KEY_SECRET=""             # Razorpay API key secret
RAZORPAY_WEBHOOK_SECRET=""         # Webhook signature verification secret
RAZORPAY_ACCOUNT_ID=""             # Route marketplace account ID

# NOTIFICATIONS
MSG91_AUTH_KEY=""                  # MSG91 authentication key
MSG91_SENDER_ID=""                 # Registered sender ID
MSG91_OTP_TEMPLATE_ID=""           # Pre-approved OTP template ID
RESEND_API_KEY=""                  # Resend email API key
RESEND_FROM_EMAIL="Kritva <noreply@kritva.in>" # From email address
EXPO_ACCESS_TOKEN=""               # Expo push notification access token

# STORAGE
R2_ACCOUNT_ID=""                  # Cloudflare account ID
R2_ACCESS_KEY_ID=""               # R2 access key
R2_SECRET_ACCESS_KEY=""           # R2 secret key
R2_BUCKET_PUBLIC=""               # Public bucket (vendor media)
R2_BUCKET_PRIVATE=""              # Private bucket (KYC documents, invoices)
R2_PUBLIC_URL=""                  # CDN URL for public bucket

# CACHE
UPSTASH_REDIS_URL=""              # Upstash Redis REST URL
UPSTASH_REDIS_TOKEN=""            # Upstash Redis REST token

# ENCRYPTION
ENCRYPTION_KEY=""                 # AES-256 key for bank account number encryption
ENCRYPTION_IV=""                  # Initialization vector

# MONITORING
SENTRY_DSN=""                     # Sentry error tracking DSN
SENTRY_AUTH_TOKEN=""              # Sentry release/sourcemap upload token
POSTHOG_API_KEY=""                # PostHog project API key
POSTHOG_HOST=""                   # PostHog instance URL

# INVOICING
GST_PROVIDER=""                   # 'cleartax' or 'zoho'
GST_API_KEY=""                    # ClearTax or Zoho Books API key
KRITVA_GSTIN=""                   # Kritva's GST registration number

# APPLICATION
NODE_ENV="development"            # 'development' | 'staging' | 'production'
API_BASE_URL="http://localhost:3000/v1" # Backend API URL
WEB_BASE_URL="http://localhost:3001"    # Web app URL (for email links, webhooks)
ADMIN_BASE_URL="http://localhost:3002"  # Admin panel URL
CORS_ORIGINS="http://localhost:3001,http://localhost:3002" # Allowed origins (comma-separated)
